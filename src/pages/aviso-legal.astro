---
// Página adicional con el diseño de la plantilla: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda-oscura">
    <div class="contenedor py-16 md:py-24">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="mt-5 max-w-[16ch] text-[clamp(2.5rem,6vw,5.5rem)] leading-[.98]">Aviso legal y privacidad</h1>
    </div>
  </section>
  <section class="banda-clara">
    <div class="contenedor grid gap-10 py-14 md:py-20 lg:grid-cols-12">
      <article class="texto-largo lg:col-span-8 lg:col-start-3">
        <h2 class="mt-0">Quiénes somos</h2>
        <p>
          Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
            c.email || 'nuestro correo de contacto'
          }{c.telefono && ` o llamarnos al ${c.telefono}`}.
        </p>
        <h2>Qué datos tratamos</h2>
        <p>
          Solo los que nos envías al escribirnos: nombre, forma de contacto, la prenda o la talla que te interesa y tu
          mensaje. Los usamos para responderte y, si nos lo pides, apartarte la prenda. No los cedemos a nadie salvo
          obligación legal.
        </p>
        <h2>Cuánto tiempo los guardamos</h2>
        <p>El necesario para atender tu consulta y, después, el que marque la ley.</p>
        <h2>Tus derechos</h2>
        <p>
          Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
          puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
        </p>
        <h2>Cookies</h2>
        <p>Esta web no usa cookies de seguimiento.</p>
        <p class="mt-12"><a class="btn" href="/">Volver al inicio</a></p>
      </article>
    </div>
  </section>
</Base>

<style>
  .texto-largo h2 { font-family: var(--fuente-titulos); font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.25rem); padding-top: 1.5rem; border-top: 1px solid var(--c-linea); }
  .texto-largo h2.mt-0 { border-top: 0; padding-top: 0; }
  .texto-largo p { color: var(--c-suave); }
</style>
