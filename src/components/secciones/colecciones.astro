---
// Colecciones: titular partido y, debajo, las colecciones de borde a borde sin margen (fotos verticales a sangre,
// 1 columna en móvil, 2 en tableta y hasta 4 en escritorio) con el nombre en serif encima de la foto.
// Lista propia `colecciones: [{ nombre, texto, imagen }]`. Al pulsar una, se filtran las novedades por esa
// colección (nombre = productos[].categoria). Sin colecciones solo se ve el titular.
import { seccion, buscarSeccion, clave } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = s ? s.colecciones.filter((c) => c.nombre) : [];
const productos = buscarSeccion('productos');
const destino = productos ? `/#${productos.id}` : '';
const columnas = Math.min(Math.max(lista.length, 1), 4);
---

{
  s && (
    <section id={Astro.props.id} class="banda-clara pt-[var(--ritmo)] md:pt-[var(--ritmo-md)]">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} lado />
      </div>
      {lista.length > 0 ? (
        <ul class="colecciones grid" style={`--cols:${columnas}`}>
          {lista.map((c, i) => {
            const Etiqueta = destino ? 'a' : 'div';
            return (
              <li class="relative">
                <Etiqueta href={destino || undefined} data-ir-categoria={destino ? clave(c.nombre) : undefined} class="coleccion group relative block overflow-hidden bg-[var(--c-oscuro)] text-white no-underline">
                  <Imagen src={c.imagen || '/placeholders/coleccion.svg'} alt={altFicha(c)} ancho={900} alto={1200} respaldo="/placeholders/coleccion.svg" class="coleccion-foto absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" aria-hidden="true" />
                  <div class="absolute inset-x-0 bottom-0 p-5 md:p-8">
                    <span class="text-[.7rem] font-semibold tracking-[.3em]">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="mt-2 text-[clamp(2.25rem,4vw,3.75rem)] leading-none">{c.nombre}</h3>
                    {c.texto && <p class="mt-3 max-w-[32ch] text-sm opacity-90">{c.texto}</p>}
                    {destino && <span class="enlace-flecha mt-2">Ver prendas</span>}
                  </div>
                </Etiqueta>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="pb-[var(--ritmo)]" />
      )}
    </section>
  )
}

<style>
  .colecciones { grid-template-columns: 1fr; }
  .coleccion { aspect-ratio: 4 / 5; }
  @media (min-width: 640px) { .colecciones { grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .colecciones { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .coleccion { aspect-ratio: auto; height: min(88svh, calc(100vw / var(--cols) * 1.45)); }
  }
  @media (min-width: 640px) and (max-width: 1023px) { .colecciones li:last-child:nth-child(odd) { grid-column: 1 / -1; } .colecciones li:last-child:nth-child(odd) .coleccion { aspect-ratio: 16 / 9; } }
</style>
