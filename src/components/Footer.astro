---
// Pie oscuro a todo el ancho: marca y redes, colecciones (de la sección `colecciones`; al pulsar filtran las
// novedades), menú (site.yaml → menu) y la tienda (dirección, horario, teléfono, correo). Debajo, el nombre
// del negocio en serif enorme como firma de revista y la línea legal. «Web creada con NoExpertise» si
// site.yaml → marca_pie no es false. Con WhatsApp en contacto, botón flotante para escribir.
import { site, tel, mapa, whatsapp, buscarSeccion, clave } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'moda' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const cols = buscarSeccion('colecciones');
const productos = buscarSeccion('productos');
const destino = productos ? `/#${productos.id}` : cols ? `/#${cols.id}` : '/';
const colecciones = cols ? cols.s.colecciones.filter((x) => x.nombre).slice(0, 10) : [];
const wa = whatsapp(c.whatsapp, `Hola, os escribo desde la web de ${site.nombre}.`);
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {
        redes.length > 0 && (
          <ul class="pie-redes">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" aria-label={red}>
                  <Icono nombre={red} tam={18} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      colecciones.length > 0 && (
        <div>
          <p class="pie-titulo">{cols?.s.antetitulo || cols?.s.titulo}</p>
          <ul class="pie-lista">
            {colecciones.map((x) => <li><a href={destino} data-ir-categoria={clave(x.nombre)}>{x.nombre}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      site.menu.length > 0 && (
        <div>
          <p class="pie-titulo">{site.nombre}</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      (c.direccion || c.telefono || c.email || c.horario) && (
        <div>
          <p class="pie-titulo">Visítanos</p>
          <ul class="pie-lista">
            {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
            {c.horario && <li class="text-sm opacity-75">{c.horario}</li>}
            {c.telefono && <li><a href={tel(c.telefono)} class="text-lg">{c.telefono}</a></li>}
            {c.email && <li><a href={`mailto:${c.email}`} class="break-words">{c.email}</a></li>}
          </ul>
        </div>
      )
    }
  </div>
  <div class="contenedor">
    <p class="pie-firma" aria-hidden="true">{site.nombre}</p>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
{
  wa && (
    <a href={wa} class="wa-flotante" rel="noopener" target="_blank" aria-label="Escríbenos por WhatsApp">
      <Icono nombre="whatsapp" tam={26} />
    </a>
  )
}
